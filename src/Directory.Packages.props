<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.3" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="5.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="16.6.1" />
    <PackageVersion Include="MonoGame.Content.Builder.Task" Version="3.8.1.303" />
    <PackageVersion Include="MonoGame.Framework.Content.Pipeline" Version="3.8.1.303" />
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="1.7.4" />
    <PackageVersion Include="NSubstitute" Version="4.2.2" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.13" />
    <PackageVersion Include="NUnit" Version="3.12" />
    <PackageVersion Include="NUnit.Runners" Version="3.11.1" />
    <PackageVersion Include="NUnit3TestAdapter" Version="3.16.1" />
    <PackageVersion Include="OptimizedPriorityQueue" Version="4.2" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="1.0.1" />
    <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />
  </ItemGroup>
</Project>
