<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>LateStartStudio.Hero6.Campaigns.RitesOfPassage</RootNamespace>
    <Version>1.0.0</Version>
    <!-- Roslyn is not able to update generated code in the IDE properly when we change the generator code so we use this hack -->
    <!--<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(ProjectDir)Generated</CompilerGeneratedFilesOutputPath>-->
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Animations\**\*.animation.json" />
    <None Remove="Animations\**\*.characteranimation.json" />
    <None Remove="Characters\**\*.character.json" />
    <None Remove="InventoryItems\**\*.inventoryitem.json" />
    <None Remove="Items\**\*.item.json" />
    <None Remove="Rooms\**\*.room.json" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="Animations\**\*.animation.json" />
    <AdditionalFiles Include="Animations\**\*.characteranimation.json" />
    <AdditionalFiles Include="Characters\**\*.character.json" />
    <AdditionalFiles Include="InventoryItems\**\*.inventoryitem.json" />
    <AdditionalFiles Include="Items\**\*.item.json" />
    <AdditionalFiles Include="Rooms\**\*.room.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hero6.Core\Hero6.Core.csproj" />
    <ProjectReference Include="..\Hero6.Engine.CodeGenerator\Hero6.Engine.CodeGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Hero6.Engine\Hero6.Engine.csproj" />
    <ProjectReference Include="..\Hero6.Localization\Hero6.Localization.csproj" />
  </ItemGroup>
  <Target Name="SkipSourceGeneratedFiles" BeforeTargets="CoreCompile">
    <!-- Roslyn is not able to update generated code in the IDE properly when we change the generator code so we use this hack -->
    <ItemGroup>
      <Compile Remove="Generated/**/*" />
    </ItemGroup>
  </Target>
</Project>