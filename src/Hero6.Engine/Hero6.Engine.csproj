<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>LateStartStudio.Hero6</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyName>Hero6.Engine</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;DESKTOP;MONOGAME</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG;DESKTOP;MONOGAME</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Gum.MonoGame" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" />
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <PackageReference Include="OptimizedPriorityQueue" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="NLog.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Hero6.Core\Hero6.Core.csproj" />
    <ProjectReference Include="..\Search\Search.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="LateStartStudio.Hero6.Animations" />
    <Using Include="LateStartStudio.Hero6.Characters" />
    <Using Include="LateStartStudio.Hero6.Components" />
    <Using Include="LateStartStudio.Hero6.DependencyInjection" />
    <Using Include="LateStartStudio.Hero6.InventoryItems" />
    <Using Include="LateStartStudio.Hero6.Items" />
    <Using Include="LateStartStudio.Hero6.Repositories" />
    <Using Include="LateStartStudio.Hero6.Rooms" />
    <Using Include="LateStartStudio.Hero6.Scripts" />
    <Using Include="LateStartStudio.Hero6.Settings" />
    <Using Include="LateStartStudio.Hero6.UserInterfaces" />
    <Using Include="LateStartStudio.Hero6.Verbs" />
  </ItemGroup>
  <ItemGroup>
    <TrimmerRootAssembly Include="Microsoft.Xna.Framework.Content.ContentTypeReader" Visible="false" />
  </ItemGroup>
</Project>